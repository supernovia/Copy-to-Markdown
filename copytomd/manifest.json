{
  "manifest_version": 3,
  "name": "Copy to Markdown",
  "version": "1.0",
  "description": "Copy HTML content as Markdown for easy sharing with bots and markdown editors",
  
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}